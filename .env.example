# TwigList environment variables. Copy to .env.local for local development (git-ignored),
# and add the same names in Vercel (Project → Settings → Environment Variables) for each environment.
# Without the Firebase and MongoDB values the app works exactly as before: local only, no "Sign in" button.

# ---------- Firebase Authentication (sign-in only, KAN-41) ----------
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration (Config).
# These are public by design (they identify the project, they don't grant access), hence NEXT_PUBLIC_.
# They are read at build time: rebuild/redeploy after changing them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# No Firebase service account key is needed: the server checks sign-ins with the project id above, and the browser
# deletes the sign-in account itself when someone deletes their account.

# ---------- MongoDB (where signed-in users' trees are stored, KAN-40) ----------
# Atlas → Database → Connect → Drivers. SECRET, server only. Use a separate cluster/user per environment.
MONGODB_URI=
# Database name inside the cluster (default: twiglist).
MONGODB_DB=twiglist

# ---------- Local development only (optional) ----------
# Use the Firebase Auth emulator instead of real Google/Microsoft sign-in: `npx firebase-tools emulators:start --only auth`.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
